<Page x:ConnectionId='1'
    x:Class="AudioSlicerPro.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:AudioSlicerPro.Models"
    xmlns:converters="using:AudioSlicerPro.Converters"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    NavigationCacheMode="Required">

    <Page.Resources>
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
        <converters:BoolNegationConverter x:Key="BoolNegationConverter" />
        <converters:PlayingToBackgroundConverter x:Key="PlayingToBackgroundConverter" />
        <converters:PlayingToForegroundConverter x:Key="PlayingToForegroundConverter" />
        <converters:PlayingToIconConverter x:Key="PlayingToIconConverter" />
        <converters:PlayingToTextConverter x:Key="PlayingToTextConverter" />
    </Page.Resources>

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock x:ConnectionId='2'                                                 FontSize="28" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" Grid.Row="0" />

        <!-- Drag & Drop / File Picker Area -->
        <Grid x:ConnectionId='3' Grid.Row="1" 
              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
              CornerRadius="12" 
              Padding="28"
              AllowDrop="True"
                           
                                   
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
              BorderThickness="1">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                <FontIcon Glyph="&#xE8B9;" FontSize="44" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                <TextBlock x:ConnectionId='34'                                                      
                           FontSize="18" FontWeight="Medium" Foreground="{ThemeResource TextFillColorPrimaryBrush}" HorizontalAlignment="Center"/>
                <Button x:ConnectionId='35'                                                           
                                                  
                        HorizontalAlignment="Center"
                        Style="{ThemeResource AccentButtonStyle}" />
            </StackPanel>
        </Grid>

        <!-- File Info Display -->
        <Border x:ConnectionId='4' Grid.Row="2" 
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                CornerRadius="8" 
                Padding="16" 
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                                                                                                                                    >
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE8D6;" FontSize="32" VerticalAlignment="Center" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                <StackPanel Grid.Column="1" Spacing="4">
                    <TextBlock x:ConnectionId='29'                                                                   FontWeight="SemiBold" FontSize="16" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock x:ConnectionId='32'                                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:ConnectionId='33'                                                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock x:ConnectionId='30'                                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:ConnectionId='31'                                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Middle Content Area: Processing Log & Output Files Preview Split Grid -->
        <Grid Grid.Row="3" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Processing Log Panel (Left) -->
            <Grid RowSpacing="8" Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock x:ConnectionId='24'                                                           FontWeight="SemiBold" FontSize="14" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                <ScrollViewer x:ConnectionId='25' Grid.Row="1" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12" x:Name="LogScrollViewer">
                    <ItemsControl x:ConnectionId='26'                                                         >
                        <ItemsControl.ItemTemplate>
                            <DataTemplate                      >
                                <TextBlock x:ConnectionId='28'                 FontFamily="Consolas" FontSize="12" Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextWrapping="Wrap" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- Output Files & Preview Panel (Right) -->
            <Grid RowSpacing="8" Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Panel Header with Open Folder Button -->
                <Grid Grid.Row="0">
                    <TextBlock x:ConnectionId='22'                                                         FontWeight="SemiBold" FontSize="14" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                    <Button x:ConnectionId='23'                                                          
                                                                                
                            HorizontalAlignment="Right" />
                </Grid>

                <!-- Output File Items List -->
                <Border Grid.Row="1" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="8">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:ConnectionId='14'                                                          >
                            <ItemsControl.ItemTemplate>
                                <DataTemplate                                   >
                                    <Border x:ConnectionId='16' Margin="0,0,0,6" 
                                            Padding="10" 
                                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                                            CornerRadius="6"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon Glyph="&#xE8D6;" FontSize="20" VerticalAlignment="Center" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock x:ConnectionId='20'                          FontWeight="Medium" FontSize="13" Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock x:ConnectionId='21'                               FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                            <!-- Play Button with Dynamic Playing State Styles -->
                                            <Button x:ConnectionId='17' Grid.Column="2" 
                                                                                 
                                                                  
                                                    ToolTipService.ToolTip="Nghe thử file này"
                                                                                                                                                         
                                                                                                                                                         >
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <FontIcon x:ConnectionId='18'                                                                                            FontSize="12" />
                                                    <TextBlock x:ConnectionId='19'                                                                                           FontSize="12" />
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>

                <!-- Built-in Audio Preview Player Card with File Info Header & Seekbar -->
                <Border x:ConnectionId='10' Grid.Row="2" 
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                        BorderThickness="1" 
                        CornerRadius="8" 
                        Padding="12"
                                                                                                                                             >
                    <StackPanel Spacing="8">
                        <!-- Currently Playing File Info Header -->
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE767;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <TextBlock Text="Đang nghe thử:" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:ConnectionId='13'                                                                    FontWeight="SemiBold" FontSize="12" Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <TextBlock x:ConnectionId='12' Grid.Column="2"                                                                         FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                        </Grid>

                        <!-- Player Transport Controls (Progress Bar / Seeker / Play-Pause) -->
                        <MediaPlayerElement x:ConnectionId='11' x:Name="AudioPreviewPlayer" 
                                            AreTransportControlsEnabled="True" 
                                            Height="60" 
                                            AutoPlay="True" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- Progress & Actions Footer -->
        <StackPanel Grid.Row="4" Spacing="12">
            <!-- Indeterminate progress shown during processing -->
            <ProgressBar x:ConnectionId='5' IsIndeterminate="True" 
                         Height="6"
                                                                                                                                         />
            <!-- Determinate progress shown when not running -->
            <ProgressBar x:ConnectionId='6'                                                         
                         Maximum="100" 
                         Height="6"
                                                                                                                                     />
            <Grid>
                <TextBlock x:ConnectionId='7'                                                      VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                    <Button x:ConnectionId='8'                                                                
                                                                               
                            Style="{ThemeResource AccentButtonStyle}"
                                                                                                                                       />
                    <Button x:ConnectionId='9'                                                       
                                                                      
                                                                                     />
                </StackPanel>
            </Grid>
        </StackPanel>
    </Grid>
</Page>

